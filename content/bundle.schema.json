      "required": [
        "id",
        "unit",
        "task",
        "mechanism",
        "timebox_min",
        "env",
        "scaffold",
        "stages",
        "acceptance",
        "hints",
        "symptoms",
        "scoring",
        "difficulty"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "unit",
    "lecture",
    "lab"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          },
          "maxItems": 200000
        }
      ]
    }
  }
}