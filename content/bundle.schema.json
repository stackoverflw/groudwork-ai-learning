        "prereq",
        "gate",
        "practice",
        "lecture",
        "produced"
      ],
      "additionalProperties": false
    },
    "lecture": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "lab": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "timebox_min": {
          "type": "integer",
          "minimum": 120,
          "maximum": 240
        },
        "env": {
          "type": "object",
          "properties": {
            "versions": {
              "type": "object",
              "properties": {
                "python": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000
                },
                "numpy": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000
                }
              },
              "required": [
                "python",
                "numpy"
              ],
              "additionalProperties": false
            },
            "vram_limit_mb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "env_vars": {
              "type": "object",
              "properties": {
                "OPENBLAS_NUM_THREADS": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000
                }
              },
              "required": [
                "OPENBLAS_NUM_THREADS"
              ],
              "additionalProperties": false
            },
            "selfcheck_cmd": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200000
            }
          },
          "required": [
            "versions",
            "vram_limit_mb",
            "env_vars",
            "selfcheck_cmd"
          ],
          "additionalProperties": false
        },
        "scaffold": {
          "type": "object",
          "properties": {
            "tree": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "minItems": 0,
              "maxItems": 100
            },
            "signatures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "minItems": 0,
              "maxItems": 100
            },
            "contract": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200000
            },
            "seed_script": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200000
            },
            "edge_cases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "minItems": 3,
              "maxItems": 3
            },
            "starter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200000
            }
          },
          "required": [
            "tree",
            "signatures",
            "contract",
            "seed_script",
            "edge_cases",
            "starter"
          ],
          "additionalProperties": false
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "goal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "expected_observation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              }
            },
            "required": [
              "goal",
              "expected_observation"
            ],
            "additionalProperties": false
          },
          "minItems": 3,
          "maxItems": 3
        },
        "acceptance": {
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200000
            },
            "correctness": {
              "type": "object",
              "properties": {
                "atol": {
                  "type": "number",
                  "minimum": 0
                },
                "rtol": {
                  "type": "number",
                  "minimum": 0
                },
                "dataset": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200000
                    },
                    {
                      "type": "object",
                      "properties": {
                        "entrypoint": {
                          "type": "string",
                          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                        },
                        "cases": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "args": {
                                "type": "array",
                                "items": {
                                  "$ref": "#/$defs/value"
                                },
                                "minItems": 1,
                                "maxItems": 10
                              },
                              "expected": {
                                "$ref": "#/$defs/value"
                              }
                            },
                            "required": [
                              "args",
                              "expected"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 3,
                          "maxItems": 100
                        },
                        "benchmark_args": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/value"
                          },
                          "minItems": 1,
                          "maxItems": 10
                        },
                        "baseline_source": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200000
                        }
                      },
                      "required": [
                        "entrypoint",
                        "cases",
                        "benchmark_args",
                        "baseline_source"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "atol",
                "rtol",
                "dataset"
              ],
              "additionalProperties": false
            },
            "perf": {
              "type": "object",
              "properties": {
                "baseline": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000
                },
                "target_x": {
                  "type": "number",
                  "minimum": 0
                },
                "protocol": {
                  "type": "object",
                  "properties": {
                    "warmup": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reps": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "metric": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200000
                    },
                    "sync": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200000
                    }
                  },
                  "required": [
                    "warmup",
                    "reps",
                    "metric",
                    "sync"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "baseline",
                "target_x",
                "protocol"
              ],
              "additionalProperties": false
            },
            "memory": {
              "type": "object",
              "properties": {
                "limit_mb": {
                  "type": "integer",
                  "minimum": 32,
                  "maximum": 8192
                },
                "api": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000
                }
              },
              "required": [
                "limit_mb",
                "api"
              ],
              "additionalProperties": false
            },
            "robustness": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "minItems": 0,
              "maxItems": 100
            }
          },
          "required": [
            "cmd",
            "correctness",
            "perf",
            "memory",
            "robustness"
          ],
          "additionalProperties": false
        },
        "hints": {
          "type": "array",
